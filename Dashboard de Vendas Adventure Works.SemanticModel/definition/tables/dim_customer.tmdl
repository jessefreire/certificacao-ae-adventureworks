table dim_customer
	lineageTag: 04b62dfc-861a-4461-a44c-4c3b4ca2e808

	/// Soma da receita liquida dos 10 clientes de maior receita no contexto de filtro atual.
	measure 'Receita Top 10 Clientes' =
			SUMX(
			    TOPN(
			        10,
			        VALUES('dim_customer'[customer_key]),
			        CALCULATE([Receita Líquida])
			    ),
			    CALCULATE([Receita Líquida])
			)
		formatString: R$ #,##0.00
		lineageTag: be0e70c4-2903-4633-90dd-ad6c5a6011a1

	/// Percentual da receita liquida total concentrado nos 10 maiores clientes.
	measure '% Receita Top 10 Clientes' =
			DIVIDE(
			    [Receita Top 10 Clientes],
			    CALCULATE([Receita Líquida], ALL('dim_customer'))
			)
		formatString: 0.0%
		lineageTag: ad22011d-0af1-41cc-917f-78822ee1ceb3

	/// Participacao do cliente (ou do contexto atual de cliente) na receita liquida total. Usado na tabela Top 10 Clientes.
	measure '% da Receita Líquida' =
			DIVIDE(
			    [Receita Líquida],
			    CALCULATE([Receita Líquida], ALL('dim_customer'))
			)
		formatString: 0.0%
		lineageTag: 116592c7-89f2-4fab-b985-fe1dcd849632

	/// Legenda de apoio pra exibir ao lado do valor absoluto de Receita Top 10 Clientes na tabela de detalhe.
	measure 'Top 10 Clientes (Texto)' = "soma dos top 10 (" & FORMAT([% Receita Top 10 Clientes], "0.0%") & " da receita total)"
		lineageTag: 0e80cbc5-e08f-45aa-a26f-db07f48b2ab3

	/// Posicao do cliente (1 a 10) dentro do recorte visivel da tabela Top 10 Clientes, ordenado por Receita Liquida.
	measure 'Ranking Cliente' =
			VAR receita = CALCULATE([Receita Líquida])
			RETURN
			IF(
			    NOT ISBLANK(receita),
			    RANKX(FILTER(ALLSELECTED(dim_customer), CALCULATE([Receita Líquida]) <> BLANK()), CALCULATE([Receita Líquida]), , DESC)
			)
		lineageTag: efc7e5a5-e535-4879-940a-c1ae18bc2971

	column customer_key
		dataType: int64
		formatString: 0
		lineageTag: 7b4cf4f8-9f77-43b1-ae1c-9c06a086be39
		summarizeBy: none
		sourceColumn: customer_key

		annotation SummarizationSetBy = Automatic

	column Cliente
		dataType: string
		lineageTag: 54196adc-1bfe-4c53-8779-ec879f3f3977
		summarizeBy: none
		sourceColumn: customer_name

		annotation SummarizationSetBy = Automatic

	column customer_type
		dataType: string
		lineageTag: 854d5798-aa33-4f3a-b058-678d132c29fd
		summarizeBy: none
		sourceColumn: customer_type

		annotation SummarizationSetBy = Automatic

	column account_number
		dataType: string
		lineageTag: 1654f3f9-257e-4936-8949-90d7e507558d
		summarizeBy: none
		sourceColumn: account_number

		annotation SummarizationSetBy = Automatic

