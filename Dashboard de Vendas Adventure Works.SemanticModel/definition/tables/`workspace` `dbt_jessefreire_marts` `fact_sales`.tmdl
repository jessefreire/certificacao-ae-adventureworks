table '`workspace` `dbt_jessefreire_marts` `fact_sales`'
	lineageTag: 05b6306f-755e-4982-8439-f87f0f9af832

	/// Receita bruta = orderqty x unitprice, somada no grao do item. Teste de aceite do CEO: 12.646.112,1607 em 2011.
	measure 'Receita Bruta' = SUM('`workspace` `dbt_jessefreire_marts` `fact_sales`'[gross_revenue])
		formatString: R$ #,##0.00
		lineageTag: 6b8512c6-7026-4b24-a223-8c9b61efdf82

	/// Receita liquida = linetotal da origem (receita bruta menos desconto).
	measure 'Receita Líquida' = SUM('`workspace` `dbt_jessefreire_marts` `fact_sales`'[net_revenue])
		formatString: R$ #,##0.00
		lineageTag: ceea070d-c0de-44ee-abb1-935a7901bf7d

	/// Contagem de pedidos distintos. Nunca COUNTROWS: a fato esta no grao do item, um pedido tem varias linhas.
	measure 'Número de Pedidos' = DISTINCTCOUNT('`workspace` `dbt_jessefreire_marts` `fact_sales`'[sales_order_id])
		formatString: #,##0
		lineageTag: 7b5200a1-24c9-4303-9c57-0157a1974339

	/// Soma de unidades vendidas (order_quantity).
	measure 'Itens Vendidos' = SUM('`workspace` `dbt_jessefreire_marts` `fact_sales`'[order_quantity])
		formatString: #,##0
		lineageTag: bf8db27f-9f88-48f3-aa9c-1d73e4b587bb

	/// Receita liquida dividida pelo numero de pedidos distintos.
	measure 'Ticket Médio' = DIVIDE([Receita Líquida], [Número de Pedidos])
		formatString: R$ #,##0.00
		lineageTag: c48acf12-dbcb-4d1a-a9f9-e05ae2b2953d

	/// Desconto total dividido pela receita bruta.
	measure 'Taxa de Desconto' = DIVIDE(SUM('`workspace` `dbt_jessefreire_marts` `fact_sales`'[discount_amount]), [Receita Bruta])
		formatString: 0.0%
		lineageTag: 80d8443a-fdba-4d39-af02-0b8a8334fecd

