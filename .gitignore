# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Entregáveis com identidade visual da Indicium AI e logos de clientes: os decks, o
# documento de acompanhamento e os notebooks exportados. Ficam fora porque este
# repositório é público.
entregaveis/

# Clones de apoio, que pertencem a quem os publicou
adventureworks-oficial/
indicium-code-style/

# dbt — o projeto fica na RAIZ do repositório, porque é o que o dbt Cloud espera e o que
# evita ter de configurar "project subdirectory". Por isso os caminhos são sem prefixo.
target/
dbt_packages/
logs/
.user.yml

# Credenciais — nunca versionar
.env
*.pem
*.key
profiles.yml

# Sistema
.DS_Store
Thumbs.db
dbt_internal_packages/

# Power BI — o projeto e versionado como PBIP (pasta de texto), nao como binario.
# O .pbix e so o formato de exportacao final pra entrega, gerado a partir do PBIP.
*.pbix

# Estado local do Power BI Desktop — nao versionar (por-maquina, cache binario).
# Sem prefixo porque a pasta .pbi aparece dentro de .Report/ e .SemanticModel/, nao na raiz.
.pbi/
